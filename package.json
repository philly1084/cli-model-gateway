{
  "name": "n8n-openai-cli-gateway",
  "version": "0.1.0",
  "description": "OpenAI-compatible Responses/Chat gateway for n8n backed by CLI providers and OAuth login jobs.",
  "private": true,
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "preflight:k8s": "node scripts/check-k8s-dist-overlays.mjs",
    "preflight:kimi-k3": "node scripts/check-kimi-k3-provider-config.mjs config/providers.example.yaml",
    "reconcile:kimi-k3": "node scripts/reconcile-kimi-k3-configmap.mjs",
    "canary:remote-agent-handoff:dry-run": "node scripts/canary-remote-agent-handoff.mjs --dry-run --mode all",
    "test:remote-agent-handoff-release": "node --test scripts/check-kimi-k3-provider-config.test.mjs scripts/reconcile-kimi-k3-configmap.test.mjs scripts/promote-remote-agent-handoff.test.mjs scripts/canary-remote-agent-handoff.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-compiled-tests.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
